# ETL-side secrets — copy to data/.env (gitignored) and fill in what you need.
# Nothing here is required for running the ETL scripts against local files;
# these gate uploads and specific gated data sources.

# Azure blob storage for uploading parquet/PMTiles artifacts
# (data/scripts/upload_parquets.py, upload_city_dev.py, stage_city.py, ...).
AZURE_STORAGE_CONNECTION_STRING=

# Datafordeler (Denmark) VUR API key — only needed to pull Copenhagen
# assessed values (run_copenhagen.py). Free registration at datafordeler.dk.
DATAFORDELER_API_KEY=

# WV IAS property-record API key — only needed to re-run the Morgantown ETL
# (morgantown.ipynb). See the notebook's markdown cell for how to obtain it.
WVIAS_API_KEY=
