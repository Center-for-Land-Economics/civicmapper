# Frontend environment variables (Vite reads .env files from THIS directory —
# vite.config.ts sets envDir to viz/env/, not the package root).
#
# Copy to .env.local for local overrides (gitignored). Every variable is
# optional: with none set, dev mode proxies dataset requests to the hosted
# dev data endpoint and the app works out of the box.
#
# ── Point the app at your own data hosting ─────────────────────────────────
# Base URL serving <city>-<state>-parcels.parquet files (and *-metadata.json).
VITE_PARQUET_BASE_URL=
# Base URL serving .pmtiles tile archives (defaults to the parquet base).
VITE_PMTILES_BASE_URL=
# Base URL serving the data dictionary JSONs (defaults to the parquet base).
VITE_DATA_DICTIONARY_BASE_URL=
# Hard override: load exactly this one dataset URL regardless of city.
VITE_DEFAULT_DATASET_URL=
# Prefer local copies in viz/public/ for files starting with this prefix
# (e.g. "spokane-wa" while iterating on a single city's parquet).
VITE_PMTILES_LOCAL_PREFIX=

# ── API / deployment ────────────────────────────────────────────────────────
# Base path or URL of the data-proxy API (default "/api").
VITE_API_BASE=
# Tile API endpoint, if serving tiles through an API instead of static hosting.
VITE_TILE_API_URL=

# ── Optional features / labels ──────────────────────────────────────────────
# Environment badge shown in the UI ("Dev", "Prod", ...). Auto-derived if unset.
VITE_ENV_LABEL=
VITE_DEPLOY_ENV=
# Google Analytics measurement id (analytics disabled when unset).
VITE_GA_ID=
# Feature flags (default on; set "false" to hide).
VITE_PARKING_ENABLED=
VITE_REPORT_ENABLED=
